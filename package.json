{
  "name": "mandate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.mcp.json --pretty false && tsc -p tsconfig.cli.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/coverage-directories.mjs",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:security": "npm run build && npm run test:security:built",
    "test:security:built": "node scripts/security-gate.mjs",
    "verify": "npm run typecheck && npm run lint && npm test -- --run && npm run test:coverage && npm run build && npm run build:mcp && npm run test:mcp && npm run test:cli && npm run test:e2e:built && npm run test:security:built",
    "test:mcp": "vitest run --config vitest.mcp.config.ts",
    "build:mcp": "tsc -p tsconfig.mcp.json --noEmit && node scripts/build-mcp.mjs",
    "build:cli": "tsc -p tsconfig.cli.json --noEmit && node scripts/build-cli.mjs",
    "test:cli": "npm run build:cli && vitest run --config vitest.cli.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@modelcontextprotocol/server": "2.3.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}

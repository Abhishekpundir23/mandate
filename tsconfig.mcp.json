{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mcp.tsbuildinfo",
    "target": "ES2023", "lib": ["ES2023"], "types": ["node"],
    "module": "ESNext", "moduleResolution": "bundler", "verbatimModuleSyntax": true,
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["integrations/mcp", "vitest.mcp.config.ts"]
}
